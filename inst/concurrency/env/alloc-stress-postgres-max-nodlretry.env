source "$here/env/_base.sh"
export LAKELAB_CATALOG="postgres:${LAKELAB_PG:-postgresql://postgres:lakelab@127.0.0.1:5432/lakelab}"
export LAKELAB_PGSETUP="${LAKELAB_PG:-postgresql://postgres:lakelab@127.0.0.1:5432/lakelab}"
export LAKELAB_NPRED=6
export LAKELAB_NCOORD=2000
export LAKELAB_SEED_ROWS=0
export LAKELAB_CREATE_MODE=if_not_exists
export LAKELAB_RETRY_MAX=2000
export LAKELAB_RETRY_TIMEOUT=300
export LAKELAB_ALLOC=max
export LAKELAB_DUCKLAKE_RETRY=0
